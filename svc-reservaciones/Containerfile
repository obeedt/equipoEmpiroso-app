# svc-reservaciones · imagen: docker.io/obeedt/devops-reservaciones:<SHA corto del commit>
FROM docker.io/library/python:3.14.10-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Usuario sin privilegios (uid fijo, para runAsNonRoot en Kubernetes)
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app

# Primero las dependencias: si solo cambia el código, esta capa se reutiliza
COPY requirements.txt .
RUN pip install --root-user-action=ignore -r requirements.txt

COPY app ./app

# El SHA del commit queda dentro de la imagen (lo muestran /health y la métrica boletera_info)
ARG VERSION=dev
ENV APP_VERSION=${VERSION}

USER 10001
EXPOSE 8000
CMD ["uvicorn", "--factory", "app.main:crear_app", "--host", "0.0.0.0", "--port", "8000"]
